@page
@model IndexModel
@{
    ViewData["Title"] = "Birthday list";
}

<div class="container">
    <div class="alert alert-dark shadow" role="alert">
        <h1 class="fs-5">Birthdays</h1>
    </div>
</div>

<div class="container mt-4">
    
    @{
        var grouped = Model.GroupedBirthDays;

    }

    <main>
        @* Display the grouped birthdays by month *@
        @foreach (var group in grouped)
        {
            <div class="mb-5">
                <h2 class="mb-3">@group.MonthName</h2>
                <div class="row">
                    @foreach (var pvm in group.Items.OrderBy(x => x.LastName))
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card shadow h-100">
                                <div class="card-body">
                                    <h3 class="card-title">@pvm.ToString("FullName", GlobalCulture.CurrentCulture)</h3>
                                    <p class="card-text">
                                        <strong>Birth Date:</strong> @pvm.BirthDate.ToString("MMMM dd, yyyy", GlobalCulture.CurrentCulture) <br/>
                                        <strong>Age:</strong> @pvm.Age.ToString(GlobalCulture.CurrentCulture)
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        }
    </main>
</div>

